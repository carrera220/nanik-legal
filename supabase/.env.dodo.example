# Fill these values, then add them as Supabase Edge Function secrets.
# Do NOT commit this file with real keys.
# Copy to: supabase/.env.dodo.local (gitignored) or paste into the Supabase dashboard.

# --- Dodo API key ---
# Where: https://app.dodopayments.com → Developer → API Keys
# Test keys start with dodo_test_
# Live keys start with dodo_live_
DODO_PAYMENTS_API_KEY=

# --- Webhook signing secret ---
# Where: https://app.dodopayments.com → Developer → Webhooks → your endpoint → Signing Secret
# Usually starts with whsec_
DODO_PAYMENTS_WEBHOOK_KEY=

# --- Environment ---
# Use test_mode until you go live. Switch to live_mode with a live API key.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# --- Product IDs ---
# Where: https://app.dodopayments.com → Products → open product → Product ID (pdt_...)
# Create two subscription products first (Monthly $14.99, Yearly $89.99 with 3-day trial).
DODO_PRODUCT_PLUS_MONTHLY=
DODO_PRODUCT_PLUS_YEARLY=

# --- Product Collection ID (preferred for web) ---
# Where: https://app.dodopayments.com → Products → Collections → open collection → Collection ID (pdc_...)
# When set, checkout shows all plans in the collection (monthly + yearly) for the customer to pick.
DODO_PRODUCT_COLLECTION_ID=

# --- App URL used for return / portal redirects ---
NANIK_WEB_APP_URL=https://nanik.app
