# Live (production) Dodo Payments — do NOT commit filled values.
# Copy to: supabase/.env.dodo.live
#
# 1) Switch Dodo dashboard to Live mode
# 2) Developer → API Keys → Create live key (dodo_live_...)
# 3) Run: DODO_LIVE_API_KEY=... WRITE_ENV=1 node scripts/dodo-mirror-live-catalog.mjs
# 4) Developer → Webhooks → create LIVE endpoint → paste Signing Secret below
# 5) Upload with: supabase secrets set --env-file supabase/.env.dodo.live --project-ref zljowsxavbpqfdskekwd

DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode

# Filled by the mirror script (or paste from Live → Products)
DODO_PRODUCT_PLUS_MONTHLY=pdt_0Nnr0OB8YTU1SFHr6qTB0
DODO_PRODUCT_PLUS_YEARLY=pdt_0Nnr0WGPr5ZQzleOMeG8S
DODO_PRODUCT_COLLECTION_ID=

NANIK_WEB_APP_URL=https://nanik.app
